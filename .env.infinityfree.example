# Copy to .env on the server; replace every YOUR_... value.
CI_ENVIRONMENT = production
app.baseURL = 'https://YOUR_DOMAIN.infinityfreeapp.com/'
app.indexPage = ''
app.appTimezone = 'Asia/Manila'
app.forceGlobalSecureRequests = true
cookie.secure = true

# Exact values from InfinityFree's MySQL Databases page. Host is NOT localhost.
database.default.hostname = 'YOUR_MYSQL_HOST'
database.default.database = 'YOUR_FULL_DATABASE_NAME'
database.default.username = 'YOUR_MYSQL_USERNAME'
database.default.password = 'YOUR_MYSQL_PASSWORD'
database.default.DBDriver = MySQLi
database.default.DBPrefix = ''
database.default.port = 3306
database.default.charset = utf8mb4
database.default.DBCollat = utf8mb4_unicode_ci
database.default.DBDebug = false

POS_SETUP_TOKEN = 'REPLACE_WITH_A_RANDOM_TOKEN_AT_LEAST_32_CHARACTERS'
